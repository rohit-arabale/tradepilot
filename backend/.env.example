# =============================================================================
# TradePilot backend — copy to `backend/.env` and fill in.
#   cp .env.example .env        (Windows: copy .env.example .env)
# =============================================================================

# ---- REQUIRED (server exits on boot without these) --------------------------

# MongoDB. Local:  mongodb://127.0.0.1:27017/tradepilot
#          Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tradepilot
MONGODB_URI=mongodb://127.0.0.1:27017/tradepilot

# JWT signing secret — MUST be at least 32 characters or every request fails.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# ---- SERVER -----------------------------------------------------------------

# Frontend dev server calls http://localhost:5050 by default — keep in sync.
PORT=5050
NODE_ENV=development

# CORS: the only origin the backend accepts. Vite dev server runs on 5173.
FRONTEND_URL=http://localhost:5173

# ---- OPTIONAL: AI features (Gemini via Google Vertex AI) --------------------
# Needed for: route optimisation insights, compliance AI, box-count vision,
# anomaly/fraud analysis, news context. The app boots without it, but those
# features return errors until it is configured.
#GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#VERTEX_AI_LOCATION=us-central1
# Local dev: path (relative to backend/) to a service-account key with the
# "Vertex AI User" role.
#GOOGLE_APPLICATION_CREDENTIALS=./Config/vertex-ai-key.json
# Production alternative: the full JSON key as one string. If set, it wins over
# the file path above — so leave it commented out unless it is real JSON.
#GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ---- OPTIONAL: Google Cloud Storage + Vision (profile photo, product analysis)
#GOOGLE_CLOUD_BUCKET_NAME=your-gcs-bucket-name
# Local dev reads the key from backend/Config/tradepilot-upload.json.
# Production: paste the JSON key string here instead.
#GOOGLE_CLOUD_CREDENTIALS_JSON=

# ---- OPTIONAL: Google Maps Platform (server key) ----------------------------
# Enable Geocoding API + Routes API on the GCP project.
#GOOGLE_API_KEY=

# ---- OPTIONAL: news + weather -----------------------------------------------
# https://newsapi.org
#NEWS_API_KEY=
# https://openweathermap.org
#OPENWEATHER_API_KEY=
