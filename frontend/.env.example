# =============================================================================
# TradePilot frontend — copy to `frontend/.env` (optional for local dev).
# =============================================================================

# Google Maps JavaScript API key (browser key). Needed only for the map view.
# Allow the referrer http://localhost:* on the key.
VITE_GOOGLE_API_KEY=

# Backend base URL. Optional — defaults per build mode:
#   dev build  -> http://localhost:5050
#   prod build -> https://tradepilot.duckdns.org
# Set it only to point the UI at a different backend.
# VITE_API_URL=http://localhost:5050

# Override just for the legacy REST `/api/analyze-product` upload endpoint.
# Falls back to VITE_API_URL when unset.
# VITE_BACKEND_URL=http://localhost:5050
